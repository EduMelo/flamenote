{"nodes": [{"id": "readme_flamenote", "label": "flamenote", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floating notes created from the currently selected text, in the spirit of Flameshot.", "_origin": "semantic"}, {"id": "readme_flameshot", "label": "Flameshot", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}, {"id": "readme_x11", "label": "X11", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The program talks to X11 directly; it does not start under Wayland.", "_origin": "semantic"}, {"id": "readme_systray_xembed", "label": "Systray (XEmbed protocol)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the classic systray protocol, the same one used by i3bar with tray_output; without a tray the hotkey still works and the program warns once.", "_origin": "semantic"}, {"id": "readme_gtk3", "label": "GTK 3", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GTK 3 draws the windows.", "_origin": "semantic"}, {"id": "readme_compositor", "label": "Compositor (e.g. picom)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With a compositor the card shadow appears; without one flamenote cuts the corners with a mask so no black square is left behind.", "_origin": "semantic"}, {"id": "readme_hotkey", "label": "Global hotkey", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default Super+Shift+N; Esc cannot be the hotkey because Esc already returns the cursor during selection and closes the toolbox.", "_origin": "semantic"}, {"id": "readme_selection_mode", "label": "Selection arming mode (crosshair)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system cursor disappears and a crosshair follows the pointer; the crosshair does not receive clicks so dragging still works in the window underneath, and the toolbox does not open at this moment.", "_origin": "semantic"}, {"id": "readme_toolbox", "label": "Toolbox", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appears next to the end of the selection, does not steal focus, and is not closed by clicking outside it; it is closed by Esc, the hotkey again, a left click on the tray, or using the tool.", "_origin": "semantic"}, {"id": "readme_note_card", "label": "Note card (bilhete)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White rounded note always above other windows; a movement under about 3 pixels does not count as a drag so that double click keeps closing it.", "_origin": "semantic"}, {"id": "readme_primary_selection", "label": "X11 PRIMARY selection", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool only accepts PRIMARY selections owned by the focused window, a parent in the window tree, another client of the same process (_NET_WM_PID) or the same X11 connection, which catches the invisible window where GTK and Chromium keep the selection.", "_origin": "semantic"}, {"id": "readme_instance_lock", "label": "Single-instance lock", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A second run arms the selection instead of creating another process; if the lock is busy and the request does not reach the main process it prints 'flamenote j\u00e1 est\u00e1 em execu\u00e7\u00e3o.' and exits.", "_origin": "semantic"}, {"id": "readme_config_toml", "label": "config.toml", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written with defaults on first run if missing and re-read every 2 seconds; an invalid hotkey falls back to the default with a terminal message.", "metadata": {"graphify_reference_stub": true}, "_origin": "semantic"}], "edges": [{"source": "readme_flamenote", "target": "readme_flameshot", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme_flamenote", "target": "readme_x11", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme_flamenote", "target": "readme_systray_xembed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "readme_flamenote", "target": "readme_gtk3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0, "_ori